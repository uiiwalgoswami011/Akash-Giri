; font-family: var(--font-family-system); font-size: var(--system-14-font-s=
ize); line-height: var(--system-14-line-height); }

body h1, body h2, body h3, body h4, body h5, body h6, body label { color: r=
gb(var(--ig-primary-text)); font-family: var(--font-family-system); }

html body a, html body a:visited { color: rgb(var(--ig-colors-button-border=
less-text)); text-decoration: none; }

html body a:active { color: rgb(var(--ig-colors-button-borderless-text--pre=
ssed)); text-decoration: underline; }

